<Project Sdk="Microsoft.NET.Sdk">
  <!-- 桌面宿主（CoreCLR）：開機、跑 N 格、印報告。不畫畫面 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ManagedDir>$(MSBuildThisFileDirectory)../out/managed</ManagedDir>
    <NoWarn>CS0618</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <ProjectReference Include="../engine/UnityNative.csproj" />
    <!-- 視窗與 GL context（只拿 glfwGetProcAddress，GL 呼叫走引擎自己的函式表） -->
    <PackageReference Include="Silk.NET.GLFW" Version="2.22.0" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <Reference Include="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
