{
  "name": "mt2-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "port": "dotnet run -c Release --project ../unity-cs2ts/converter -- web '*'",
    "hierarchy": "dotnet run --project ../unity-cs2ts/converter -- --hierarchy public/game/scenes/hierarchy.json",
    "import": "uv run ../unity-cs2ts/importer/run.py",
    "shaders": "uv run ../unity-cs2ts/importer/run.py shaders",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
