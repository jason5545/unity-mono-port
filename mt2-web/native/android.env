# unity-native/android.sh 讀的遊戲設定（MT2）。路徑相對於 unity-native/
APP_ID=com.jason5545.mt2native
APP_TITLE="Monster Train 2"
# 圖示跟 mt2-web 的 APK 同一份：原版 MonsterTrain2.exe 的圖示（scripts/app_icon.py 產生前景 PNG 到 build/apk-res），adaptive icon 的 XML 在殼的 res
APP_PREPARE="cd ../mt2-web && uv run -q scripts/app_icon.py"
APP_RES="../mt2-web/android/app/src/main/res ../mt2-web/build/apk-res"
GAME_DIR=../mt2-web/public/game
DATA_DIR=../mt2-web/reference/game-win-2.2.1/MonsterTrain2_Data
# android.sh 啟動時的自動點擊（格數:x,y，畫面比例、左上原點；分號隔開）：第 400 格點標題畫面中央，進到地圖（跟桌面版 --click 400:1280,720 一樣）
AUTO_CLICKS="400:0.5,0.5"
